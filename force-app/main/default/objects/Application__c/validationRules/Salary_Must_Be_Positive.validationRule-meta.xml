<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Salary_Must_Be_Positive</fullName>
    <active>true</active>
    <errorConditionFormula>AND( NOT(ISBLANK( Expected_Salary__c )), Expected_Salary__c &lt;=0)</errorConditionFormula>
    <errorDisplayField>Expected_Salary__c</errorDisplayField>
    <errorMessage>Expected Salary 0 peksha jast pahije.</errorMessage>
</ValidationRule>
